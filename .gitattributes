* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.csv text eol=lf
# Preserve quoted original-reference bytes and CSV record endings in AI exports.
revision_preparation/annotation/ai_review/*.csv -text -whitespace
*.gz binary
*.png binary

# Preserve new archived table bytes, including original CSV record endings.
revision_preparation/review_round2/**/*.csv -text -whitespace
# Generated SVG path records retain renderer whitespace and artifact hashes.
revision_preparation/review_round2/**/*.svg -whitespace
