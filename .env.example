# Copy to .env. Shell environment variables take precedence over this file.
# The development launcher reads .env automatically.

# Local SQLite working database, restored from the packaged snapshot.
DATABASE_URL=sqlite:///./database/ipcc_litdb.sqlite
API_HOST=127.0.0.1
API_PORT=8077
FRONTEND_DIR=./frontend

# Review workflow.
ALLOW_WRITES=true
CHANGED_BY=dashboard-user
MAX_PAGE_SIZE=200

# Optional OpenAI-compatible API. Enable after adding your own credentials.
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=15

# Optional PostgreSQL export/import target for bash scripts/migrate.sh.
# This connection is independent of the dashboard's SQLite database.
# POSTGRES_URL=postgresql://ipcc_user:YOUR_PASSWORD@localhost:5432/ipcc_litdb
